{
  "$id": "planning/probe-run-result@1",
  "title": "Probe eval run result (v1.1 probe validation: one candidate run per probe, deterministic scoring)",
  "type": "object",
  "required": [
    "schema", "probe_id", "version", "run_id", "planning", "governor",
    "checks", "score", "verdict", "evidence"
  ],
  "properties": {
    "schema": { "const": "planning/probe-run-result@1" },
    "probe_id": { "enum": ["P1", "P2", "P3", "P4", "P5", "P6"] },
    "version": { "enum": ["v1.0", "v1.1"] },
    "run_id": { "type": "string", "minLength": 1 },
    "planning": {
      "type": "object",
      "required": ["audit_count", "revision_rounds", "subagent_count", "artifact_count"],
      "properties": {
        "audit_count": { "type": "integer", "minimum": 0 },
        "revision_rounds": { "type": "integer", "minimum": 0 },
        "subagent_count": { "type": "integer", "minimum": 0 },
        "artifact_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 },
        "wall_time_seconds": { "type": ["integer", "null"] },
        "tokens": { "type": ["integer", "null"] }
      }
    },
    "governor": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "enum": ["EXECUTE", "SPIKE", "TARGETED_PATCH", "HUMAN_BLOCKER", "absent"] },
        "spikes": { "type": "array", "items": { "type": "string" } },
        "deferred": { "type": "array", "items": { "type": "string" } },
        "budget_exceeded": { "type": "boolean" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "pass", "detail"],
        "properties": {
          "name": { "type": "string" },
          "pass": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "verdict": { "enum": ["PASS", "PASS_WITH_NOTES", "PATCH_REQUIRED", "REOPEN_ARCHITECTURE"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact", "observation"],
        "properties": {
          "artifact": { "type": "string" },
          "observation": { "type": "string" }
        }
      }
    },
    "baseline": {
      "type": ["object", "null"],
      "description": "For probes with a v1.0 baseline (P1, P5): the baseline run's summary, kept in the same result for comparison.",
      "properties": {
        "run_id": { "type": "string" },
        "score": { "type": "number" },
        "audit_count": { "type": "integer" },
        "task_count": { "type": "integer" },
        "delta": { "type": "string" }
      }
    }
  }
}
