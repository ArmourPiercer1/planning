{
  "$id": "planning/task-package@1",
  "title": "Task Package (self-contained brief for one execution agent)",
  "type": "object",
  "required": [
    "schema", "task_id", "objective", "required_context", "inputs",
    "frozen_contracts", "owned_paths", "allowed_dependencies", "non_goals",
    "implementation_constraints", "deliverables", "acceptance_tests",
    "failure_cases", "integration_dependency", "handoff", "risk"
  ],
  "properties": {
    "schema": { "const": "planning/task-package@1" },
    "task_id": { "type": "string", "pattern": "^T[0-9]{2,}$" },
    "objective": { "type": "string", "minLength": 30 },
    "required_context": {
      "type": "object",
      "required": ["files", "contracts", "concepts"],
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "contracts": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]+$" } },
        "concepts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "frozen_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contract_id", "spec_ref"],
        "properties": {
          "contract_id": { "type": "string", "pattern": "^C[0-9]+$" },
          "spec_ref": { "type": "string" }
        }
      }
    },
    "owned_paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "allowed_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "what"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^T[0-9]{2,}$" },
          "what": { "type": "string" }
        }
      }
    },
    "non_goals": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "implementation_constraints": { "type": "array", "items": { "type": "string" } },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["what", "where"],
        "properties": { "what": { "type": "string" }, "where": { "type": "string" } }
      }
    },
    "acceptance_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "case", "description", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "case": { "enum": ["positive", "negative", "failure"] },
          "description": { "type": "string", "minLength": 10 },
          "evidence": { "type": "string", "minLength": 5 }
        }
      }
    },
    "failure_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario", "expected_behavior"],
        "properties": { "scenario": { "type": "string" }, "expected_behavior": { "type": "string" } }
      }
    },
    "integration_dependency": {
      "type": "object",
      "required": ["seams", "upstream_outputs", "consumers"],
      "properties": {
        "seams": { "type": "array", "items": { "type": "string", "pattern": "^S[0-9]+$" } },
        "upstream_outputs": { "type": "array", "items": { "type": "string" } },
        "consumers": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{2,}$" } }
      }
    },
    "handoff": {
      "type": "object",
      "required": ["checkpoint_required", "checkpoint_ref", "downstream_consumers", "notes"],
      "properties": {
        "checkpoint_required": { "type": "boolean" },
        "checkpoint_ref": { "type": "string" },
        "downstream_consumers": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{2,}$" } },
        "notes": { "type": "string" }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "context_footprint", "touched_layers", "cross_contracts", "statefulness",
        "integration_distance", "uncertainty", "p50", "p80", "compaction_risk",
        "warnings"
      ],
      "properties": {
        "context_footprint": { "enum": ["S", "M", "L", "XL"] },
        "touched_layers": { "type": "array", "items": { "type": "string" } },
        "cross_contracts": { "type": "integer", "minimum": 0 },
        "statefulness": { "enum": ["low", "medium", "high"] },
        "integration_distance": { "enum": ["low", "medium", "high"] },
        "uncertainty": { "enum": ["low", "medium", "high"] },
        "p50": { "type": "string" },
        "p80": { "type": "string" },
        "compaction_risk": { "enum": ["low", "medium", "high"] },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "detail", "rationale"],
            "properties": {
              "code": { "type": "string" },
              "detail": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        },
        "oversized_justification": { "type": ["string", "null"] }
      }
    }
  }
}
