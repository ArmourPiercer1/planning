{
  "$id": "planning/audit@3",
  "title": "Plan audit verdict (v3: adds routing-aware findings gated by delivery profile)",
  "type": "object",
  "required": ["schema", "verdict", "auditor", "findings", "deterministic", "checks_performed", "grounding"],
  "properties": {
    "schema": { "const": "planning/audit@3" },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "auditor": {
      "type": "object",
      "required": ["path", "planner_conversation_isolated"],
      "properties": {
        "path": { "enum": ["fresh_subagent", "fresh_session", "same_session_late_pass"] },
        "planner_conversation_isolated": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "grounding": {
      "type": "object",
      "description": "Repo grounding: which snapshot the auditor verified against and what it checked.",
      "properties": {
        "snapshot_ref": { "type": "string" },
        "repo_revision": { "type": "string" },
        "files_verified": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "check", "evidence", "suggested_fix"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]{2,}$" },
          "severity": { "enum": ["BLOCKER", "MAJOR", "MINOR"] },
          "routing": {
            "enum": ["EXECUTION_BLOCKER", "SPIKE_REQUIRED", "POST_STAGE", "OPTIONAL"],
            "description": "Routing category for the planning governor. Default: BLOCKER=EXECUTION_BLOCKER, MAJOR=SPIKE_REQUIRED or POST_STAGE, MINOR=OPTIONAL. The governor may override."
          },
          "check": {
            "enum": [
              "scope_creep", "insufficient_non_goals", "late_contract_freeze",
              "hidden_dependency", "fake_serialization", "ownership_collision",
              "oversized_leaf", "broad_context_loading", "hidden_integration_work",
              "nondeterministic_acceptance", "lack_of_local_recoverability",
              "replan_only_by_append", "communication_overhead",
              "schema_invalid", "deterministic_lint",
              "over_planning", "missing_spike_route"
            ]
          },
          "task_id": { "type": ["string", "null"], "pattern": "^T[0-9]{2,}$" },
          "evidence": { "type": "string", "minLength": 10 },
          "suggested_fix": { "type": "string" },
          "acceptance_ref": {
            "type": ["string", "null"],
            "description": "If this finding cites a specific stage acceptance criterion, name its id (A1..). Required for EXECUTION_BLOCKER routing."
          },
          "delivery_profile_note": {
            "type": ["string", "null"],
            "description": "If severity was adjusted by delivery profile, explain (e.g. 'demoted to OPTIONAL: not required for alpha')."
          }
        }
      }
    },
    "deterministic": {
      "type": "object",
      "required": ["tool", "exit_code", "finding_count"],
      "properties": {
        "tool": { "type": "string" },
        "exit_code": { "type": "integer" },
        "finding_count": { "type": "integer", "minimum": 0 }
      }
    },
    "checks_performed": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "revision_round": { "type": "integer", "minimum": 1 },
    "delivery_profile_applied": {
      "type": ["string", "null"],
      "description": "The delivery profile level that was active during audit (e.g. 'alpha'). Null if not specified."
    }
  }
}
