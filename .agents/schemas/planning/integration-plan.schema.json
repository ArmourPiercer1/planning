{
  "$id": "planning/integration-plan@2",
  "title": "Integration plan (v2: structured merge and omission semantics for integration kinds)",
  "type": "object",
  "required": ["schema", "seams", "integration_tasks", "e2e_gates"],
  "properties": {
    "schema": { "const": "planning/integration-plan@2" },
    "seams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "contract_ids", "covered_by"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]+$" },
          "description": { "type": "string" },
          "contract_ids": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]+$" }, "minItems": 1 },
          "covered_by": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{2,}$" }, "minItems": 1 }
        }
      }
    },
    "integration_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "kind", "seams", "owns_fixes_for", "acceptance_ref"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^T[0-9]{2,}$" },
          "kind": { "enum": ["contract_consistency", "seam_integration", "e2e_closure", "final_acceptance"] },
          "merged_kinds": {
            "type": "array",
            "description": "Integration kinds this task ALSO carries (structurally merged). e.g. an e2e_closure task that executes final acceptance end to end lists final_acceptance here. A kind carried by merged_kinds is satisfied exactly like a primary kind; the merge must never be notes-only.",
            "items": { "enum": ["contract_consistency", "seam_integration", "e2e_closure", "final_acceptance"] }
          },
          "seams": { "type": "array", "items": { "type": "string", "pattern": "^S[0-9]+$" } },
          "owns_fixes_for": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{2,}$" } },
          "acceptance_ref": { "type": "string", "pattern": "^A[0-9]+$" }
        }
      }
    },
    "omitted_kinds": {
      "type": "array",
      "description": "Integration kinds that are deliberately NOT run in this Stage, each with a structured, verifiable justification. A kind is satisfied when it is present (primary or merged) or legitimately omitted here. Omitting seam_integration while a leaf still creates new files in an existing seam directory is a planning defect (HIDDEN_INTEGRATION_WORK).",
      "items": {
        "type": "object",
        "required": ["kind", "reason", "evidence"],
        "properties": {
          "kind": { "enum": ["contract_consistency", "seam_integration", "e2e_closure", "final_acceptance"] },
          "reason": { "type": "string", "minLength": 15 },
          "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "e2e_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scenario", "covers", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^E[0-9]+$" },
          "scenario": { "type": "string", "minLength": 10 },
          "covers": { "type": "array", "items": { "type": "string", "pattern": "^S[0-9]+$" }, "minItems": 1 },
          "evidence": { "type": "string", "minLength": 5 }
        }
      }
    }
  }
}
